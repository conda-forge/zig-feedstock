From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MementoRC <MementoRC@users.noreply.github.com>
Date: Mon, 10 Mar 2026 00:00:00 +0000
Subject: [PATCH] Add --export-all-symbols to libLLVM on MinGW

Backport from LLVM 22.1.0: without --export-all-symbols, MinGW auto-
export does not export data symbols (vtables, static ::ID members) when
any symbol has __declspec(dllexport). This causes undefined symbol
errors when linking libclang-cpp.dll against libLLVM.dll.a.

atexit from dllcrt2.obj also gets exported; build.sh post-processes
the import library via zig dlltool to remove it.

For win-arm64 cross-builds, the PE/COFF format imposes a hard cap of
65535 exported symbols; LLVM 20.x exceeds this (~79k symbols) when
--export-all-symbols is used. On ARM64, use a curated .def file
(generated by extract_symbols.py, passed via LLVM_ARM64_EXPORT_DEF)
instead. LLVM_ARM64_EXPORT_DEF is set only by _cmake_flags.sh for the
win-arm64 cross build; its presence alone is the correct discriminator.

---
 llvm/tools/llvm-shlib/CMakeLists.txt | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/llvm/tools/llvm-shlib/CMakeLists.txt b/llvm/tools/llvm-shlib/CMakeLists.txt
--- a/llvm/tools/llvm-shlib/CMakeLists.txt
+++ b/llvm/tools/llvm-shlib/CMakeLists.txt
@@ -41,6 +41,20 @@
     llvm_install_library_symlink(LLVM-${LLVM_VERSION_MAJOR}${LLVM_VERSION_SUFFIX} $<TARGET_FILE_NAME:LLVM> SHARED FULL_DEST COMPONENT LLVM)
   endif()

+  if (MINGW OR CYGWIN)
+    # The LLVM DLL is supposed to export all symbols (except for ones
+    # that are explicitly hidden). Normally, this is what happens anyway, but
+    # if there are symbols that are marked explicitly as dllexport, we would only
+    # export them and nothing else. Therefore, add --export-all-symbols to
+    # make sure we export all symbols despite potential dllexports.
+    if(DEFINED LLVM_ARM64_EXPORT_DEF)
+      # win-arm64: PE/COFF 65535 export cap. Use curated .def file generated by extract_symbols.py.
+      target_link_options(LLVM PRIVATE LINKER:-def:${LLVM_ARM64_EXPORT_DEF} LINKER:-verbose)
+    else()
+      target_link_options(LLVM PRIVATE LINKER:--export-all-symbols)
+    endif()
+  endif()
+
   list(REMOVE_DUPLICATES LIB_NAMES)
   if("${CMAKE_SYSTEM_NAME}" STREQUAL "Darwin")
     set(LIB_NAMES -Wl,-all_load ${LIB_NAMES})
