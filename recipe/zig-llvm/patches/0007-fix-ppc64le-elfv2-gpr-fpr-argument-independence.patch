From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MementoRC <MementoRC@users.noreply.github.com>
Date: Thu, 30 Jul 2026 00:00:00 +0000
Subject: [PATCH] Fix PPC64 ELFv2 GPR/FPR argument-counter independence

Under the PPC64 ELFv2 (SVR4) ABI, GPR and FPR/VR argument-register
classes are independent: a named scalar float/vector argument that is
satisfied from an available FPR/VR must NOT consume or shadow a GPR
slot. LowerFormalArguments_64SVR4 and LowerCall_64SVR4 both derived
GPR_idx from the position-based ArgOffset/NumBytes counter, which
advances for every argument regardless of register class -- correct
for ELFv1 (where FP args do shadow a GPR) and for vararg calls (which
intentionally mirror named args into GPRs), but wrong for ELFv2 named
calls.

Confirmed via minimal IR repro compiled with
`llc -mtriple=powerpc64le-unknown-linux-gnu -O2`:

  declare double @foo(double, i32)
  define double @caller(double %x, i32 %e) {
    %r = call double @foo(double %x, i32 %e)
    ret double %r
  }

Unpatched, `%e` is materialized into r4 immediately before `bl foo`;
per the ELFv2 ABI it must be r3, since the preceding `double` occupies
f1 and never touches a GPR. This is invisible when both caller and
callee are generated by the same (buggy) codegen, but breaks at any
call boundary to a separately-compiled, ABI-compliant function (e.g.
glibc, or any AOT C code) -- the callee reads the argument from the
ABI-correct register and gets garbage.

Fix: introduce a GPRShadowOffset counter that mirrors the existing
position-based offset for GPR-index purposes only, skipping its
advance exclusively when the current argument is a named (non-vararg)
scalar float/vector actually satisfied from an available FPR/VR under
ELFv2. Every other argument shape (integers, aggregates, vararg, or
FPR/VR-exhausted floats/vectors) keeps the original alignment-aware
position tracking, including the quadword-alignment GPR skip required
for aggregates.

Verified after patching: `%e` lands in r3 for the repro above; a mixed
4-argument case (double, double, i32, i32, double) also places both
i32s in the correct registers. A 16-byte-aligned byval-aggregate-after-
i64 case and a vararg call produce byte-for-bit-identical assembly to
the unpatched baseline (this fix is fully gated off for those paths,
as intended). Not independently verified: f128/vector arguments
actually hitting the VR branch of this fix, and PPC64 big-endian
(ELFv1) targets -- the ABI/vararg gates should make ELFv1 unaffected
by construction, but no BE build was performed to confirm.

---
 llvm/lib/Target/PowerPC/PPCISelLowering.cpp | 61 +++++++++++++++++++++++-----
 1 file changed, 55 insertions(+), 6 deletions(-)

--- a/llvm/lib/Target/PowerPC/PPCISelLowering.cpp
+++ b/llvm/lib/Target/PowerPC/PPCISelLowering.cpp
@@ -4566,6 +4566,16 @@
   // although the first ones are often in registers.

   unsigned ArgOffset = LinkageSize;
+  // Under ELFv2, a named scalar float/vector argument satisfied from an
+  // available FPR/VR never shadows a GPR (GPR and FPR/VR argument classes
+  // are counted independently), so GPR_idx must not be derived from the
+  // overall (position-based) ArgOffset in that case -- ArgOffset still
+  // advances for such an argument (it may need a parameter-save-area slot
+  // for e.g. a later vararg access), but no GPR is consumed for it. This
+  // shadow offset mirrors ArgOffset except it skips that one case, so the
+  // GPR index it yields stays correct, including the alignment-driven GPR
+  // skip still required for quadword-aligned aggregates.
+  unsigned GPRShadowOffset = LinkageSize;
   unsigned GPR_idx = 0, FPR_idx = 0, VR_idx = 0;
   SmallVector<SDValue, 8> MemOps;
   Function::const_arg_iterator FuncArg = MF.getFunction().arg_begin();
@@ -4598,9 +4608,28 @@
     if (CallConv != CallingConv::Fast) {
       ComputeArgOffset();

-      /* Compute GPR index associated with argument offset.  */
-      GPR_idx = (ArgOffset - LinkageSize) / PtrByteSize;
-      GPR_idx = std::min(GPR_idx, Num_GPR_Regs);
+      // See the GPRShadowOffset comment above: skip the GPR-index update
+      // only for a named (non-vararg) scalar float/vector argument that
+      // will actually be satisfied from an available FPR/VR under ELFv2.
+      bool ArgConsumesFPRVROnly =
+          isELFv2ABI && !isVarArg &&
+          (((ObjectVT == MVT::f32 || ObjectVT == MVT::f64) &&
+            FPR_idx != Num_FPR_Regs) ||
+           ((ObjectVT == MVT::v4f32 || ObjectVT == MVT::v4i32 ||
+             ObjectVT == MVT::v8i16 || ObjectVT == MVT::v16i8 ||
+             ObjectVT == MVT::v2f64 || ObjectVT == MVT::v2i64 ||
+             ObjectVT == MVT::v1i128 || ObjectVT == MVT::f128) &&
+            VR_idx != Num_VR_Regs));
+
+      if (!ArgConsumesFPRVROnly) {
+        GPRShadowOffset = alignTo(GPRShadowOffset, Alignment);
+        /* Compute GPR index associated with argument offset.  */
+        GPR_idx = (GPRShadowOffset - LinkageSize) / PtrByteSize;
+        GPR_idx = std::min(GPR_idx, Num_GPR_Regs);
+        GPRShadowOffset += CalculateStackSlotSize(ObjectVT, Flags, PtrByteSize);
+        if (Flags.isInConsecutiveRegsLast())
+          GPRShadowOffset = alignTo(GPRShadowOffset, PtrByteSize);
+      }
     }

     // FIXME the codegen can be much improved in some cases.
@@ -6272,6 +6301,11 @@
   // area is 32 bytes reserved space for [SP][CR][LR][TOC].
   unsigned LinkageSize = Subtarget.getFrameLowering()->getLinkageSize();
   unsigned NumBytes = LinkageSize;
+  // See the matching comment in LowerFormalArguments_64SVR4: this shadow
+  // offset mirrors ArgOffset for GPR-index purposes only, skipping the
+  // advance for a named scalar float/vector argument satisfied from an
+  // available FPR/VR under ELFv2 (which never shadows a GPR).
+  unsigned GPRShadowOffset = LinkageSize;
   unsigned GPR_idx = 0, FPR_idx = 0, VR_idx = 0;

   static const MCPhysReg GPR[] = {
@@ -6456,9 +6490,30 @@
     if (!IsFastCall) {
       ComputePtrOff();

-      /* Compute GPR index associated with argument offset.  */
-      GPR_idx = (ArgOffset - LinkageSize) / PtrByteSize;
-      GPR_idx = std::min(GPR_idx, NumGPRs);
+      // See the GPRShadowOffset comment near its declaration above: skip
+      // the GPR-index update only for a named (non-vararg) scalar
+      // float/vector argument that will actually be satisfied from an
+      // available FPR/VR under ELFv2.
+      bool ArgConsumesFPRVROnly =
+          isELFv2ABI && !CFlags.IsVarArg &&
+          (((ArgVT == MVT::f32 || ArgVT == MVT::f64) && FPR_idx != NumFPRs) ||
+           ((ArgVT == MVT::v4f32 || ArgVT == MVT::v4i32 ||
+             ArgVT == MVT::v8i16 || ArgVT == MVT::v16i8 ||
+             ArgVT == MVT::v2f64 || ArgVT == MVT::v2i64 ||
+             ArgVT == MVT::v1i128 || ArgVT == MVT::f128) &&
+            VR_idx != NumVRs));
+
+      if (!ArgConsumesFPRVROnly) {
+        auto ShadowAlignment =
+            CalculateStackSlotAlignment(ArgVT, OrigVT, Flags, PtrByteSize);
+        GPRShadowOffset = alignTo(GPRShadowOffset, ShadowAlignment);
+        /* Compute GPR index associated with argument offset.  */
+        GPR_idx = (GPRShadowOffset - LinkageSize) / PtrByteSize;
+        GPR_idx = std::min(GPR_idx, NumGPRs);
+        GPRShadowOffset += CalculateStackSlotSize(ArgVT, Flags, PtrByteSize);
+        if (Flags.isInConsecutiveRegsLast())
+          GPRShadowOffset = alignTo(GPRShadowOffset, PtrByteSize);
+      }
     }

     // Promote integers to 64-bit values.
