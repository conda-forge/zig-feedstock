# Purpose: Add -mlongcall to zigcpp and zig2 compile options to prevent R_PPC64_REL24 overflow on ppc64le
# Affects: CMakeLists.txt (zigcpp and zig2 target_compile_options)
# Upstream: TBD
# Drop-when: conda-forge ppc64le LLVM static archives compiled with -mlongcall, or conda-forge switches to shared LLVM
# Last-verified: 2026-05-13

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -522,6 +522,19 @@
 set_property(TARGET zigcpp PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded")
 endif()

+# ppc64le: 24-bit relative branches cannot span the >32MB distance to LLVM
+# symbols in shared libs.  Force indirect (CTR-based) calls for all zigcpp TUs.
+if(CMAKE_SYSTEM_PROCESSOR STREQUAL "powerpc64le")
+  message(STATUS "zig-0005-debug: zigcpp ppc64le compile flags applied")
+  target_compile_options(zigcpp PRIVATE
+      -mlongcall
+      -fno-ipa-cp
+      -fno-partial-inlining
+      -ffunction-sections
+      -fdata-sections
+  )
+endif()
+
 target_include_directories(zigcpp PUBLIC
     ${CLANG_INCLUDE_DIRS}
     ${LLVM_INCLUDE_DIRS}
@@ -716,6 +716,19 @@
 target_include_directories(zig2 PUBLIC stage1)
 target_link_libraries(zig2 LINK_PUBLIC zigcpp)

+# ppc64le: zig2.c is a ~11M-line auto-generated C TU; same 32MB branch limit
+# applies.  Force indirect calls so the linker can resolve all cross-unit refs.
+if(CMAKE_SYSTEM_PROCESSOR STREQUAL "powerpc64le")
+  message(STATUS "zig-0005-debug: zig2 ppc64le compile flags applied")
+  target_compile_options(zig2 PRIVATE
+      -mlongcall
+      -fno-ipa-cp
+      -fno-partial-inlining
+      -ffunction-sections
+      -fdata-sections
+  )
+endif()
+
 if(MSVC)
   target_link_libraries(zig2 LINK_PUBLIC ntdll.lib ws2_32.lib)
 elseif(MINGW)
