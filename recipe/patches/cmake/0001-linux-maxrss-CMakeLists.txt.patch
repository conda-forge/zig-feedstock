# Purpose: Set --maxrss 7000000000 in cmake ZIG_BUILD_ARGS to cap zig stage3 build memory on Linux
# Affects: CMakeLists.txt (ZIG_BUILD_ARGS)
# Upstream: TBD
# Drop-when: Upstream CMakeLists.txt sets adequate --maxrss, or conda-forge Linux runners have >7 GB available
# Last-verified: 2026-05-12

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ef371fc..01a4f23 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -915,6 +915,7 @@ set(ZIG_BUILD_ARGS
   "-Dconfig_h=${ZIG_CONFIG_H_OUT}"
 
   -Dno-langref
+  --maxrss 7000000000
 )
 
 set(ZIG_EXTRA_BUILD_ARGS "" CACHE STRING "Extra zig build args")
