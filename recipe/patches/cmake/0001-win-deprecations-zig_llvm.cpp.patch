# Purpose: Replace strdup() with _strdup() in zig_llvm.cpp to eliminate MSVC deprecation warnings
# Affects: src/zig_llvm.cpp
# Upstream: TBD
# Drop-when: Upstream zig_llvm.cpp uses _strdup() on MSVC builds, or MSVC removes the deprecation
# Last-verified: 2026-05-12

--- a/src/zig_llvm.cpp
+++ b/src/zig_llvm.cpp
@@ -230,7 +230,7 @@
         std::error_code EC;
         dest_asm_ptr = new(std::nothrow) raw_fd_ostream(options->asm_filename, EC, sys::fs::OF_None);
         if (EC) {
-            *error_message = strdup((const char *)StringRef(EC.message()).bytes_begin());
+            *error_message = _strdup((const char *)StringRef(EC.message()).bytes_begin());
             return true;
         }
     }
@@ -238,7 +238,7 @@
