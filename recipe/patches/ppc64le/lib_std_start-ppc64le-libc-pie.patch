 fn noopSigHandler(_: i32) callconv(.c) void {}
+
+// ppc64le ELFv2 _start emulating glibc's Scrt1.o.
+// Calling convention for __libc_start_main on ppc64le glibc:
+//   Kernel passes: r3=argc, r4=argv, r5=envp, r6=auxv, r7=rtld_fini
+//   Scrt1.o sets:  r8=main, r9=stack_end
+//   Then branches to __libc_start_main (NOT a regular C call).
+// We must NOT clobber r3..r7 with C-signature args.
+extern fn __libc_start_main() callconv(.c) noreturn;
+
+fn ppc64le_libc_start() callconv(.naked) noreturn {
+    asm volatile (
+        // ELFv2 ABI: on entry r12 holds the entry-point address; derive TOC.
+        \\ addis 2, 12, .TOC. - 0f@ha
+        \\ addi  2, 2,  .TOC. - 0f@l
+        \\ 0:
+        // Save stack_end (original sp) into r9 BEFORE we modify r1.
+        \\ mr 9, 1
+        // Align stack to 16 bytes, allocate 32-byte frame, NULL back chain.
+        \\ clrrdi 1, 1, 4
+        \\ li 0, 0
+        \\ stdu 1, -32(1)
+        \\ std  0, 0(1)
+        \\ mtlr 0
+        // Load address of `main` from TOC into r8 (per ppc64le glibc convention).
+        \\ addis 8, 2, main@toc@ha
+        \\ ld    8, main@toc@l(8)
+        // r3..r7 are passed through from kernel (argc/argv/envp/auxv/rtld_fini).
+        // Tail-call __libc_start_main; the nop reserves the TOC-restore slot
+        // required by ELFv2 ABI for external PLT calls.
+        \\ b __libc_start_main
+        \\ nop
+    );
+}
