+//! Shared libc++ discovery for conda-forge zig packaging (darwin targets only).
+//! Probes the user's library search dirs (-L) and then dirs relative to
+//! zig_lib_dir for a shared libc++ dylib, falling back to null (caller
+//! uses static libc++.a). Other targets always get null.
+//!
+//! A candidate is accepted only if its Mach-O header matches the target
+//! architecture, so a host-arch dylib is never linked into a cross-arch
+//! target.
+
+const std = @import("std");
+const Io = std.Io;
+const Allocator = std.mem.Allocator;
+const Cache = std.Build.Cache;
+const Compilation = @import("../Compilation.zig");
+
+/// Shared library names for libc++ on darwin.
+const shared_names = [_][]const u8{ "libc++.1.dylib", "libc++.dylib" };
+
+/// Probe directories relative to zig_lib (which is <prefix>/lib/zig/).
+/// Two levels up reaches <prefix>/, then:
+///   - <prefix>/lib/zig-llvm/lib/  (preferred: dedicated zig-llvm package)
+///   - <prefix>/lib/                (fallback: standard lib dir)
+const probe_subdirs = [_][]const u8{
+    "../../lib/zig-llvm/lib",
+    "../../lib",
+};
+
+const mh_magic_64: u32 = 0xfeedfacf;
+const fat_magic: u32 = 0xcafebabe;
+const fat_magic_64: u32 = 0xcafebabf;
+const cputype_x86_64: u32 = 0x01000007;
+const cputype_arm64: u32 = 0x0100000c;
+
+fn machoCpuType(arch: std.Target.Cpu.Arch) ?u32 {
+    return switch (arch) {
+        .x86_64 => cputype_x86_64,
+        .aarch64 => cputype_arm64,
+        else => null,
+    };
+}
+
+/// True if the Mach-O file at `path` contains a slice for `want` (a cputype).
+/// Any read error or unknown magic yields false.
+fn machoHasCpuType(io: Io, path: []const u8, want: u32) bool {
+    const file = Io.Dir.cwd().openFile(io, path, .{}) catch return false;
+    defer file.close(io);
+
+    var head: [8]u8 = undefined;
+    const n = file.readPositionalAll(io, &head, 0) catch return false;
+    if (n != head.len) return false;
+
+    // Thin 64-bit, little-endian: magic, then cputype.
+    if (std.mem.readInt(u32, head[0..4], .little) == mh_magic_64) {
+        return std.mem.readInt(u32, head[4..8], .little) == want;
+    }
+
+    // Fat, big-endian: magic, nfat_arch, then fat_arch entries.
+    const magic = std.mem.readInt(u32, head[0..4], .big);
+    const entry_size: usize = switch (magic) {
+        fat_magic => 20, // cputype, cpusubtype, offset, size, align
+        fat_magic_64 => 32, // cputype, cpusubtype, offset(8), size(8), align, reserved
+        else => return false,
+    };
+    const nfat = std.mem.readInt(u32, head[4..8], .big);
+    // A real fat file holds a handful of slices; bound the scan.
+    if (nfat == 0 or nfat > 64) return false;
+
+    var i: usize = 0;
+    while (i < nfat) : (i += 1) {
+        var ent: [4]u8 = undefined;
+        const got = file.readPositionalAll(io, &ent, 8 + i * entry_size) catch return false;
+        if (got != ent.len) return false;
+        if (std.mem.readInt(u32, &ent, .big) == want) return true;
+    }
+    return false;
+}
+
+fn candidateOk(comp: *const Compilation, probe: []const u8) bool {
+    const io = comp.io;
+    Io.Dir.cwd().access(io, probe, .{}) catch return false;
+    const target = &comp.root_mod.resolved_target.result;
+    const want = machoCpuType(target.cpu.arch) orelse return false;
+    return machoHasCpuType(io, probe, want);
+}
+
+/// Find shared libc++ and return its path as a string (for argv-based linkers).
+/// Searches the user's -L dirs first, then zig_lib-relative dirs.
+/// Returns null if no shared libc++ found. Errors only on allocation failure.
+pub fn findSharedLibCxxString(comp: *const Compilation, arena: Allocator) !?[]const u8 {
+    const target = &comp.root_mod.resolved_target.result;
+
+    // Shared libc++ is a conda osx policy; other targets keep static libc++.a.
+    if (!target.os.tag.isDarwin()) return null;
+
+    // Opt-in: shared only when ZIG_LIBCXX is exactly "shared"; else static (upstream).
+    const opt = comp.environ_map.get("ZIG_LIBCXX") orelse return null;
+    if (!std.mem.eql(u8, opt, "shared")) return null;
+
+    for (comp.lib_directories) |dir| {
+        const dir_path = dir.path orelse ".";
+        for (&shared_names) |name| {
+            const probe = try std.fs.path.join(arena, &.{ dir_path, name });
+            if (candidateOk(comp, probe)) return probe;
+        }
+    }
+
+    const zig_lib_path = comp.dirs.zig_lib.path orelse return null;
+
+    for (&probe_subdirs) |subdir| {
+        for (&shared_names) |name| {
+            const probe = try std.fs.path.join(arena, &.{ zig_lib_path, subdir, name });
+            if (candidateOk(comp, probe)) return probe;
+        }
+    }
+    return null;
+}
+
+// Find shared libc++ and return its Cache.Path (for MachO system_libs).
+// Uses Cache.Path.initCwd(); the probe string may be relative to the cwd (a -L dir can be).
+// Returns null if no shared libc++ found.
+pub fn findSharedLibCxxPath(comp: *const Compilation, arena: Allocator) !?Cache.Path {
+    const str = try findSharedLibCxxString(comp, arena) orelse return null;
+    return Cache.Path.initCwd(str);
+}
