# Purpose: Honour -Wl,--no-as-needed for bundled glibc stub libs (conda-forge/zig-feedstock#209).
# Problem: createModule drops -l<libc-name> queries (isLibCLibName -> link_libc) and
#          with them the `needed` flag, so elfLink emits every bundled glibc stub
#          under --as-needed. `-Wl,--no-as-needed -lm` then yields no DT_NEEDED on
#          libm.so.6, breaking consumers that rely on it (e.g. dlopen by SONAME).
# Fix:     main.zig records libc lib names requested while --no-as-needed was active
#          and passes them via Compilation.CreateOptions.libc_no_as_needed_libs
#          (hashed into the link cache manifest). elfLink wraps only those stubs in
#          --no-as-needed/--as-needed. Default stays pristine: all stubs --as-needed.
# Host:    unconditional; behaviour is target-keyed (isGnuLibC), identical on all hosts.
# Supersedes: linux/Lld.zig-no-unconditional-as-needed-glibc-bundled.patch
# Upstream: not filed
# Drop-when: upstream propagates `needed` for libc lib names
# Applies-after: Lld.zig-macho-lld-support.patch, Lld.zig-prefer-shared-libcxx.patch (osx)
# Last-verified: 2026-10-12 (zig 0.18.0-dev.146+35accc06e, LLVM 23)
--- a/src/main.zig
+++ b/src/main.zig
@@ -3670,6 +3670,7 @@
         .mingw_unicode_entry_point = mingw_unicode_entry_point,
         .link_inputs = create_module.link_inputs.items,
         .windows_lib_names = create_module.windows_libs.keys(),
+        .libc_no_as_needed_libs = create_module.libc_no_as_needed_libs.items,
         .want_compiler_rt = if (zig_cc_explicitly_link_compiler_rt) true else want_compiler_rt,
         .want_ubsan_rt = want_ubsan_rt,
         .hash_style = hash_style,
@@ -3996,6 +3997,8 @@
     /// `unresolved_link_inputs` and `windows_libs`.
     cli_link_inputs: std.ArrayList(link.UnresolvedInput),
     windows_libs: std.array_hash_map.String(void),
+    /// libc lib names (e.g. "m") passed via -l while --no-as-needed was active.
+    libc_no_as_needed_libs: std.ArrayList([]const u8) = .empty,
     /// The local variable `unresolved_link_inputs` is fed into library
     /// resolution, mutating the input array, and producing this data as
     /// output. Allocated with gpa.
@@ -4134,4 +4137,5 @@
                 if (std.zig.target.isLibCLibName(target, lib_name)) {
                     create_module.opts.link_libc = true;
+                    if (nq.query.needed) try create_module.libc_no_as_needed_libs.append(arena, lib_name);
                     continue;
                 }
--- a/src/Compilation.zig
+++ b/src/Compilation.zig
@@ -95,6 +95,8 @@
 function_sections: bool,
 data_sections: bool,
 link_eh_frame_hdr: bool,
+/// libc lib names to link with --no-as-needed (bundled glibc stubs only).
+libc_no_as_needed_libs: []const []const u8,
 native_system_include_paths: []const []const u8,
 /// List of symbols forced as undefined in the symbol table
 /// thus forcing their resolution by the linker.
@@ -1515,6 +1517,7 @@
     linker_max_memory: ?u64 = null,
     linker_global_base: ?u64 = null,
     linker_export_symbol_names: []const []const u8 = &.{},
+    libc_no_as_needed_libs: []const []const u8 = &.{},
     linker_print_gc_sections: bool = false,
     linker_print_icf_sections: bool = false,
     linker_print_map: bool = false,
@@ -2145,6 +2148,7 @@
             .native_system_include_paths = options.native_system_include_paths,
             .force_undefined_symbols = options.force_undefined_symbols,
             .link_eh_frame_hdr = link_eh_frame_hdr,
+            .libc_no_as_needed_libs = options.libc_no_as_needed_libs,
             .global_cc_argv = options.global_cc_argv,
             .file_system_inputs = options.file_system_inputs,
             .parent_whole_cache = options.parent_whole_cache,
@@ -3399,6 +3403,7 @@
     man.hash.add(comp.zigc_strat);
     man.hash.add(comp.rc_includes);
     man.hash.addListOfBytes(comp.force_undefined_symbols.keys());
+    man.hash.addListOfBytes(comp.libc_no_as_needed_libs);
     man.hash.add(comp.framework_dirs.len);
     for (comp.framework_dirs) |framework_dir| {
         man.hash.addBytes(framework_dir.path orelse ".");
--- a/src/link/Lld.zig
