# non-unix: Suppress LLD's [importeddllmain] warning (COFF linker)
#
# xml2.lib (and potentially other import libraries) export DllMain, which
# triggers LLD's -WARN:importeddllmain diagnostic.  Zig's stderr-fatal
# heuristic treats any unexpected LLD warning as a hard error, crashing
# the win-64 Stage 2 build.  Add -IGNORE:importeddllmain to silence the
# warning before it reaches that heuristic.

diff --git a/src/link/Lld.zig b/src/link/Lld.zig
--- a/src/link/Lld.zig
+++ b/src/link/Lld.zig
@@ -477,6 +477,7 @@
         }
 
         try argv.appendSlice(gpa, &.{ "-ERRORLIMIT:0", "-NOLOGO" });
+        try argv.append(gpa, "-IGNORE:importeddllmain");
         if (comp.config.debug_format != .strip) {
             try argv.append(gpa, "-DEBUG");
 
