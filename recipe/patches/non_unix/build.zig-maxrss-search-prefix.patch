+    // Windows MSVC: force dynamic CRT linkage. Default is .static, which
+    // makes zig auto-add libucrt.lib (static) for `link_libc=true`. Our
+    // zigcpp.lib is built with /MD (DEFAULTLIB:msvcrt → ucrt.lib dynamic)
+    // and the manual `-lmsvcrt` from config.h's ZIG_LLVM_LIBRARIES is also
+    // dynamic. Mixing static libucrt with dynamic ucrt produces ~40
+    // lld-link "duplicate symbol" errors (errno, abort, malloc, …).
+    if (options.target.result.os.tag == .windows and options.target.result.abi == .msvc) {
+        exe.linkage = .dynamic;
+    }
