# Purpose: Switch zigcpp MSVC runtime from /MT (static) to /MD (dynamic) to match conda-forge LLVM and avoid lld-link /failifmismatch CRT mismatch errors
# Affects: Non-Unix (Windows) build of zig 0.15.x
# Upstream: not filed
# Drop-when: zig upstream aligns zigcpp CRT setting with conda-forge LLVM build, or conda-forge LLVM switches to /MT
# Last-verified: 2026-05-12 (build 23)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -710,8 +710,9 @@
     -Wno-comment
   )
 else()
+add_compile_options(/wd4715 /wd4291)
 target_compile_options(zigcpp PRIVATE /Zc:preprocessor)
-set_property(TARGET zigcpp PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded")
+set_property(TARGET zigcpp PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
 endif()

 target_include_directories(zigcpp PUBLIC
