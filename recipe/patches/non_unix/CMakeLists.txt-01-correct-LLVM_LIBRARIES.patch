# Purpose: Strip .dll extensions from LLVM_LIBRARIES and add msvcrt.lib to fix conda MSVC toolchain linking (prevents zstd.dll.lib double-extension)
# Affects: CMakeLists.txt
# Upstream: not filed
# Drop-when: conda-forge LLVM Windows packages ship clean import-lib names without .dll suffix
# Last-verified: 2026-05-12 (build 23)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -147,6 +147,8 @@
     find_library(ZLIB NAMES libz.a libzlibstatic.a z zlib libz NAMES_PER_DIR)
     list(APPEND LLVM_LIBRARIES "${ZLIB}")
 endif()
+string(REPLACE ".dll" "" LLVM_LIBRARIES "${LLVM_LIBRARIES}")
+list(APPEND LLVM_LIBRARIES "msvcrt.lib")

 if(ZIG_STATIC_ZSTD)
     if (MSVC)
