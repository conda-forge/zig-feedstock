# Purpose: Force exe.linkage = .dynamic on windows-msvc to avoid CRT duplicate-symbol errors
# Affects: build.zig (addCompilerStep)
# Upstream: not filed
# Drop-when: zig defaults to .dynamic CRT linkage on windows-msvc, OR zigcpp.lib switches to /MT static CRT
# Last-verified: 2026-10-28 (zig 0.18.0-dev.738+ae9a8acc7, LLVM 23)
# Note: Mixing static libucrt with dynamic ucrt produces ~40 lld-link duplicate-symbol errors
#       (errno, abort, malloc, ...) because zigcpp.lib uses /MD (dynamic) and config.h's
#       ZIG_LLVM_LIBRARIES manual -lmsvcrt is also dynamic.

--- a/build.zig
+++ b/build.zig
@@ -931,6 +931,16 @@ fn addCompilerStep(b: *std.Build, options: AddCompilerModOptions) *std.Build.Step.Compile {
     });
     exe.stack_size = stack_size;
 
+    // Windows MSVC: force dynamic CRT linkage. Default is .static, which
+    // makes zig auto-add libucrt.lib (static) for `link_libc=true`. Our
+    // zigcpp.lib is built with /MD (DEFAULTLIB:msvcrt -> ucrt.lib dynamic)
+    // and the manual `-lmsvcrt` from config.h's ZIG_LLVM_LIBRARIES is also
+    // dynamic. Mixing static libucrt with dynamic ucrt produces ~40
+    // lld-link "duplicate symbol" errors (errno, abort, malloc, ...).
+    if (options.target.result.os.tag == .windows and options.target.result.abi == .msvc) {
+        exe.linkage = .dynamic;
+    }
+
     return exe;
 }
 
