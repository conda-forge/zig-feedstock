# Purpose: Split cfg.llvm_lib_dir on semicolons and add each as a library search path
# Affects: Non-Unix (Windows) build of zig 0.15.x
# Upstream: not filed
# Drop-when: Upstream supports multi-path llvm_lib_dir natively
# Last-verified: 2026-05-12 (build 23)

diff --git a/build.zig b/build.zig
index 37523e6..a151dc6 100644
--- a/build.zig
+++ b/build.zig
@@ -790,7 +790,11 @@
     assert(cfg.lld_include_dir.len != 0);
     mod.addIncludePath(.{ .cwd_relative = cfg.lld_include_dir });
     mod.addIncludePath(.{ .cwd_relative = cfg.llvm_include_dir });
-    mod.addLibraryPath(.{ .cwd_relative = cfg.llvm_lib_dir });
+    // Split system_lib_dir by semicolon and add each path
+    var it = std.mem.splitScalar(u8, cfg.llvm_lib_dir, ';');
+    while (it.next()) |path| {
+        mod.addLibraryPath(.{ .cwd_relative = path });
+    }
     addCMakeLibraryList(mod, cfg.clang_libraries);
     addCMakeLibraryList(mod, cfg.lld_libraries);
     addCMakeLibraryList(mod, cfg.llvm_libraries);
