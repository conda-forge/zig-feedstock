# Purpose: Remove automatic ucrt.lib injection in LLD COFF link to prevent duplicate symbols with conda MSVC toolchain
# Affects: src/link/Lld.zig
# Upstream: TBD
# Drop-when: conda-forge Windows toolchain stops providing its own ucrt, or upstream Zig gates ucrt on toolchain detection
# Last-verified: 2026-05-12

--- a/src/link/Lld.zig
+++ b/src/link/Lld.zig
@@ -684,7 +684,6 @@
                             .dynamic => "",
                         };
                         try argv.append(try allocPrint(arena, "{s}vcruntime.lib", .{lib_str}));
-                        try argv.append(try allocPrint(arena, "{s}ucrt.lib", .{lib_str}));

                         //Visual C++ 2015 Conformance Changes
                         //https://msdn.microsoft.com/en-us/library/bb531344.aspx
