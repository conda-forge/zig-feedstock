# Purpose: Downgrade .shr_exact to .shr when safety is enabled to prevent LLVM-20 PowerPC backend from folding the safety back-shift check into a no-op
# Affects: src/Sema.zig
# Upstream: not filed
# Drop-when: LLVM-20 PowerPC backend fixes @shrExact codegen, or zig switches to self-hosted backend on ppc64le
# Last-verified: 2026-05-12 (build 23)

--- a/src/Sema.zig
+++ b/src/Sema.zig
@@ -13260,7 +13260,15 @@
         break :rs rhs_src;
     };
     try sema.requireRuntimeBlock(block, src, runtime_src);
-    const result = try block.addBinOp(air_tag, lhs, rhs);
+    // When safety is enabled, downgrade .shr_exact to .shr so the runtime
+    // back-shift check (`shl(result, rhs) == lhs`) is not eliminated by
+    // LLVM InstCombine.  LLVM treats `lshr exact` as a UB promise that no
+    // bits are lost, which lets it fold `shl(lshr_exact(x,N), N)` → `x`,
+    // turning the safety comparison into a trivial `x == x` and dropping the
+    // panic branch.  When safety is off (ReleaseFast/ReleaseSmall) we keep
+    // .shr_exact so LLVM can still exploit the UB promise for optimisation.
+    const result_tag: Air.Inst.Tag = if (air_tag == .shr_exact and block.wantSafety()) .shr else air_tag;
+    const result = try block.addBinOp(result_tag, lhs, rhs);
     if (block.wantSafety()) {
         const bit_count = scalar_ty.intInfo(zcu).bits;
         if (!std.math.isPowerOfTwo(bit_count)) {
