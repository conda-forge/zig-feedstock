# Purpose: Strip glibc version suffix from LLVM triple to avoid mismatches with conda-forge glibc 2.17/2.28 sysroots
# Affects: src/codegen/llvm.zig
# Upstream: not filed
# Drop-when: conda-forge linux glibc floor advances past a version where the suffix causes no issues, or upstream handles this
# Last-verified: 2026-05-12 (build 23)

--- a/src/codegen/llvm.zig
+++ b/src/codegen/llvm.zig
@@ -295,13 +295,8 @@
         .semver,
         .windows,
         => {},
-        inline .hurd, .linux => |ver| if (target.abi.isGnu()) {
-            try llvm_triple.print("{d}.{d}.{d}", .{
-                ver.glibc.major,
-                ver.glibc.minor,
-                ver.glibc.patch,
-            });
-        } else if (@TypeOf(ver) == std.Target.Os.LinuxVersionRange and target.abi.isAndroid()) {
+        .hurd => {},
+        .linux => |ver| if (target.abi.isAndroid()) {
             try llvm_triple.print("{d}", .{ver.android});
         },
     }
